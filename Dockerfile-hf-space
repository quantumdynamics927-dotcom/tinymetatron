# Dockerfile for TinyMetatron SLM + Copilot v2 — Hugging Face Docker Space.
# Python 3.13-slim, CPU-only torch. Extended for copilot orchestration.
# Ships Phase 1-4: 17-agent copilot, τ-bench/SWE-bench, P0-P3 security hardening.
FROM python:3.13-slim

# ── HF Space metadata ──────────────────────────────────────────────────────────
# These labels are read by hf Hub to populate the Space page.
LABEL com.huggingface.space.metadata.title="TinyMetatron Copilot"
LABEL com.huggingface.space.metadata.description="17-agent multi-agent orchestration for sparse-attention MoE training — real loops, RAG, φ-routing"
LABEL com.huggingface.space.metadata.color="purple"
LABEL com.huggingface.space.metadata.emoji="🧠"
LABEL com.huggingface.space.metadata.sdk="docker"
LABEL com.huggingface.space.metadata.license="mit"
LABEL org.opencontainers.image.source="https://github.com/quantumdynamics927-dotcom/tinymetatron"
LABEL org.opencontainers.image.version="2.0.0"

WORKDIR /app

# Environment: UTF-8 stdio, import path, runtime paths, deploy mode.
# TMT_DEPLOY_MODE=demo -> read-only public Space (training/data-write disabled).
# COPILOT_MODE=simulation -> agents run in dry-run without real loop execution.
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    TMT_DB_PATH=/app/metatron.db \
    TMT_CHECKPOINT_DIR=/app/ckpt \
    TMT_DEPLOY_MODE=demo \
    COPILOT_MODE=simulation

# ── Python dependencies ─────────────────────────────────────────────────────────
# fastapi/uvicorn: REST layer
# websockets: /copilot/ws WebSocket endpoint
# slowapi: rate limiting (P0)
# pydantic[email]: request validation
# pyyaml: config files
# numpy: tensor ops
# qiskit: HYBRID quantum lane (optional; degrades gracefully if absent)
# quantum-corpus: RAG backbone + benchmark data (Phase 1)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir \
        "fastapi>=0.115.0" \
        "uvicorn[standard]>=0.34.0" \
        "pydantic[email]>=2.10.0" \
        "slowapi>=0.1.9" \
        "pyyaml>=6.0" \
        "numpy>=1.26" \
        "websockets>=14.0" \
        "qiskit>=1.3.0" \
        "qiskit-ibm-provider>=0.11.0"

# Install quantum-corpus from PyPI (includes RAG + benchmark tasks for Phase 1).
RUN pip install --no-cache-dir "quantum-corpus>=0.4.0"

# ── App ───────────────────────────────────────────────────────────────────────
# Copy the flat repo (no package) into /app.
COPY . /app

# Ensure runtime directories for data and checkpoints exist.
RUN mkdir -p /app/data /app/ckpt

# Build-time training: seed a small corpus and train a checkpoint so the Space
# ships with a real active model in /app/ckpt + an active row in /app/metatron.db.
# /generate finds the active checkpoint at runtime with no extra config.
# (~20-40s on a CPU builder for a 6.35M model; no large file committed to the repo.)
RUN python manage_data.py generate --domain cybersecurity --count 400 \
        --db_path /app/metatron.db \
    && python train_db.py --steps 300 --domain cybersecurity \
        --min_quality 0.4 --db_path /app/metatron.db --checkpoint_dir /app/ckpt

# ── Security (P3) ─────────────────────────────────────────────────────────────
# Run as non-root user (principle of least privilege).
RUN useradd --create-home --shell /bin/bash --uid 1000 metatron \
    && chown -R metatron:metatron /app
USER metatron

# Health check on the /health endpoint (no auth required).
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:7860/health')"

# Hugging Face Docker Spaces expect the app on port 7860 (app_port in README).
EXPOSE 7860

# Serve the FastAPI app (module-level `app` in api.py) on all interfaces.
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "7860"]
