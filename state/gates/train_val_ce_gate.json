{
  "name": "train_val_ce_below_3.0",
  "version": 1,
  "description": "Training run must achieve val CE below 3.0 at best checkpoint",
  "worker": "workers.evaluate.compute_ce",
  "argv": [
    "python", "-m", "workers.evaluate.compute_ce",
    "--run-id", "{run_id}",
    "--eval-set", "val",
    "--best-only"
  ],
  "timeout_seconds": 300,
  "pass_condition": {
    "metric": "ce",
    "operator": "<",
    "value": 3.0
  }
}
